          "writable": true,
          "signer": true
        },
        {
          "name": "room",
          "docs": [
            "The delegated room, held in the Ephemeral Rollup during SubmissionOpen."
          ],
          "writable": true
        },
        {
          "name": "room_session",
          "docs": [
            "Present when the caller is using a session key instead of their main",
